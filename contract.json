{
  "title": "The Missing Layer",
  "says": "A busy board for the browser. Every knob is something this tab can already do.",
  "what": "The site holds no application and no data. It gives a grammar, and each browser that opens it is one live state. This file is the whole board: the one script on the site is a generator that reads it and turns the shapes it knows into running code.",
  "rule": "One screen: no scroll, no navigation. No text is ever run as code; the page asks the browser to refuse it. Only shapes the generator knows become code.",
  "screen": {
    "width": 1280,
    "height": 800
  },
  "doors": {
    "knobs": "Touch a store, touch a verb, type into Name and Value, touch Do. Undo takes back the last thing done.",
    "shape": "Type or paste JSON into Shape and touch Generate. A shape is one of: a run {\"store\", \"verb\", \"Name\", \"Value\"}; bare steps {\"steps\": [...]}; a list of shapes; or a whole contract like this file, which rebuilds the board.",
    "round trip": "Everything that runs is listed under Ran as the shape it was, with the code it stood for. Touch a line to put it back in Shape, or touch Hand back for all of it in order, then Generate.",
    "floppy": "Save downloads what the board is and holds as plain JSON; Load takes the files back and rebuilds it. The same through Shape: {\"keep\": true} writes the floppies into Shape, {\"keep\": {\"size\": 4000}} makes each at most that many bytes, and Generate takes them back, in any order. A floppy holds records: the board, each store, each thing held. It never holds code; the generator rebuilds from the records. From a script: board.serialize(size) and board.deserialize(floppies)."
  },
  "grammar": {
    "from": "start at one of: document, box, localStorage, sessionStorage, indexedDB, cookieStore, caches, history, location",
    "call": "call a method on the current thing; \"with\" lists what is passed",
    "get": "read a property of the current thing",
    "set": "write a property of the current thing; \"to\" is the value",
    "new": "make a Response or a URL; \"with\" lists what is passed",
    "as": "give the current thing a name; \"$name\" passes it later",
    "use": "go back to a named thing",
    "part": "run a named list of steps from \"parts\"",
    "entries": "turn the current thing into name and value pairs",
    "each": "run steps on every member of the current list",
    "gather": "run several lists of steps and keep each result under its own name",
    "words": "{Name} and {Value} are filled from the run; {Name:uri} makes it safe in an address; {Value:before=} and {Value:after=} split at the first equals sign",
    "keep": "on a store: how it is kept on a floppy. \"empty\" is the shape that empties it; \"each\" is the shape that puts one thing back, with {name} and {value} filled from the record. A store that holds elements needs only \"empty\". A store with no \"keep\" is not kept."
  },
  "parts": {
    "thing": [
      {
        "from": "document"
      },
      {
        "call": "getElementById",
        "with": [
          "{Name}"
        ]
      }
    ],
    "things": [
      {
        "from": "indexedDB"
      },
      {
        "call": "open",
        "with": [
          "board",
          1
        ],
        "upgrade": [
          {
            "call": "createObjectStore",
            "with": [
              "things",
              {
                "keyPath": "name"
              }
            ]
          }
        ]
      },
      {
        "call": "transaction",
        "with": [
          "things",
          "readwrite"
        ]
      },
      {
        "call": "objectStore",
        "with": [
          "things"
        ]
      }
    ],
    "shelf": [
      {
        "from": "caches"
      },
      {
        "call": "open",
        "with": [
          "board"
        ]
      }
    ]
  },
