            },
            {
              "get": "textContent"
            }
          ],
          "undo": {
            "store": "dom",
            "verb": "say",
            "Name": "{Name}",
            "Value": "{Was}"
          }
        },
        {
          "verb": "set",
          "needs": [
            "Name",
            "Value"
          ],
          "does": "Sets an attribute, written attribute=value.",
          "steps": [
            {
              "part": "thing"
            },
            {
              "call": "setAttribute",
              "with": [
                "{Value:before=}",
                "{Value:after=}"
              ]
            }
          ],
          "says": "{Name} has {Value}",
          "none": "nothing is called {Name}",
          "was": [
            {
              "part": "thing"
            },
            {
              "call": "getAttribute",
              "with": [
                "{Value:before=}"
              ]
            }
          ],
          "undo": {
            "store": "dom",
            "verb": "set",
            "Name": "{Name}",
            "Value": "{Value:before=}={Was}"
          },
          "undo if none": {
            "store": "dom",
            "verb": "unset",
            "Name": "{Name}",
            "Value": "{Value:before=}"
          }
        },
        {
