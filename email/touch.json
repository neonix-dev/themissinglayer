  "things": {
    "start": [
      {
        "after": 0,
        "then": [
          {
            "part": "only inbox"
          }
        ]
      }
    ],
    "compose": [
      {
        "touched": "email.wire.new",
        "then": [
          {
            "part": "only compose"
          }
        ]
      }
    ],
    "cancel": [
      {
        "touched": "email.wire.cancel",
        "then": [
          {
            "part": "only inbox"
          }
        ]
      }
    ],
    "to-sent": [
      {
        "touched": "email.wire.to-sent",
        "then": [
          {
            "part": "only sent"
          }
        ]
      }
    ],
    "to-inbox": [
      {
        "touched": "email.wire.to-inbox",
        "then": [
          {
            "part": "only inbox"
          }
        ]
      }
    ],
    "back": [
      {
        "touched": "email.wire.back",
