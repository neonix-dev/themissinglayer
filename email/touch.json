        "with": [
          "email.wire.inbox"
        ]
      },
      {
        "set": "hidden",
        "to": false
      },
      {
        "from": "document"
      },
      {
        "call": "getElementById",
        "with": [
          "email.wire.sent"
        ]
      },
      {
        "set": "hidden",
        "to": true
      },
      {
        "from": "document"
      },
