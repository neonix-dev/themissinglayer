            "part": "only inbox"
          }
        ]
      }
    ],
    "send": [
      {
        "touched": "email.wire.send",
        "then": [
          {
            "from": "document"
          },
          {
            "call": "getElementById",
            "with": [
              "email.wire.subject"
            ]
          },
          {
            "as": "s"
          },
          {
            "get": "value"
          },
          {
            "as": "n"
          },
          {
            "from": "document"
          },
          {
            "call": "getElementById",
            "with": [
              "email.wire.body"
            ]
          },
          {
            "as": "b"
          },
          {
            "get": "value"
          },
          {
            "as": "v"
          },
          {
            "part": "sent"
          },
          {
            "call": "put",
            "with": [
              {
                "name": "$n",
                "value": "$v"
              }
            ]
          },
          {
            "use": "s"
          },
          {
            "set": "value",
            "to": ""
          },
          {
            "use": "b"
          },
          {
            "set": "value",
            "to": ""
          },
          {
            "part": "only sent"
          }
        ]
      }
    ],
    "open": [
      {
        "touched": "email.wire.inbox-list",
        "then": [
          {
            "use": "touched"
          },
          {
            "get": "textContent"
          },
          {
            "as": "n"
          },
          {
            "part": "inbox"
          },
          {
            "call": "get",
            "with": [
              "$n"
            ]
          },
          {
            "get": "value"
          },
          {
            "as": "v"
          },
          {
            "from": "document"
          },
          {
            "call": "getElementById",
            "with": [
              "email.wire.read-subject"
            ]
          },
          {
            "set": "textContent",
            "to": "$n"
          },
          {
            "from": "document"
          },
          {
            "call": "getElementById",
            "with": [
              "email.wire.read-body"
            ]
          },
          {
            "set": "textContent",
            "to": "$v"
          },
          {
            "part": "only message"
          }
        ]
      }
    ],
    "open-sent": [
      {
        "touched": "email.wire.sent-list",
        "then": [
          {
            "use": "touched"
          },
          {
            "get": "textContent"
          },
          {
            "as": "n"
