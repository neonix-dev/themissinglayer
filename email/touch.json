{
  "id": "email.touch",
  "says": "The interaction of the email: what a touch does. One layout shows at a time, compose opens, send puts the mail in sent, a row opens. It makes nothing of its own.",
  "parts": {
    "inbox": [
      {
        "from": "indexedDB"
      },
      {
        "call": "open",
        "with": [
          "email.inbox",
          1
        ],
        "upgrade": [
          {
            "call": "createObjectStore",
            "with": [
              "mail",
              {
                "keyPath": "name"
              }
            ]
          }
        ]
      },
      {
        "call": "transaction",
        "with": [
          "mail",
          "readwrite"
        ]
      },
      {
        "call": "objectStore",
        "with": [
          "mail"
        ]
      }
    ],
    "sent": [
      {
        "from": "indexedDB"
      },
      {
        "call": "open",
        "with": [
          "email.sent",
          1
        ],
