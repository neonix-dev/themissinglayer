  "stores": [
    {
      "store": "inbox",
      "is": "Mail that came in. Kept in this browser.",
      "holds": [
        {
          "part": "inbox"
        },
        {
          "call": "getAll"
        }
      ],
      "keep": {
        "empty": {
          "store": "email.wire.inbox",
          "verb": "clear"
        },
        "each": {
          "store": "email.wire.inbox",
          "verb": "put",
          "Name": "{name}",
          "Value": "{value}"
        }
      },
      "verbs": [
        {
          "verb": "put",
          "needs": [
            "Name",
            "Value"
          ],
          "does": "Keeps a mail: Name is its subject, Value is what it says.",
          "steps": [
            {
              "part": "inbox"
            },
            {
              "call": "put",
              "with": [
                {
                  "name": "{Name}",
                  "value": "{Value}"
                }
              ]
            }
          ],
          "says": "{Name} = {Value}"
        },
        {
          "verb": "get",
          "needs": [
            "Name"
          ],
          "does": "Reads the mail with that subject.",
          "steps": [
            {
              "part": "inbox"
            },
            {
              "call": "get",
              "with": [
                "{Name}"
              ]
            },
            {
              "get": "value"
            }
          ],
          "says": "{Name} holds {result}",
          "none": "nothing is called {Name}"
        },
        {
          "verb": "remove",
          "needs": [
            "Name"
          ],
          "does": "Deletes the mail with that subject.",
          "steps": [
            {
              "part": "inbox"
            },
            {
              "call": "delete",
              "with": [
                "{Name}"
              ]
            }
          ],
          "says": "{Name} is forgotten"
        },
        {
          "verb": "clear",
          "needs": [],
          "does": "Deletes every mail here.",
          "steps": [
            {
              "part": "inbox"
            },
            {
              "call": "clear"
            }
          ],
          "says": "all forgotten"
        }
      ]
    },
